<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<title>Phishing Analiz Raporu{% if subject %} — {{ subject }}{% endif %}</title>
<style>
  body {
    font-family: -apple-system, "Segoe UI", Arial, sans-serif;
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
    color: #1a1a1a;
    line-height: 1.5;
  }
  .risk-banner {
    padding: 1rem 1.25rem;
    border-radius: 6px;
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .risk-phishing { background: #fdecea; color: #7a1f1f; border: 1px solid #f5c2c0; }
  .risk-muhtemel { background: #fff4e5; color: #7a4a00; border: 1px solid #f5d8a0; }
  .risk-guvenilir { background: #eaf7ec; color: #1e5c2a; border: 1px solid #b7ddbe; }

  .meta {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  section { margin-bottom: 1.75rem; }
  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #444;
    border-bottom: 1px solid #ddd;
    padding-bottom: 0.3rem;
  }
  .finding {
    margin-bottom: 0.9rem;
    padding-left: 0.75rem;
    border-left: 3px solid #ccc;
  }
  .finding-baslik { font-weight: 600; }
  .finding-aciklama { color: #333; }
  ul.gostergeler { padding-left: 1.25rem; }
  ul.gostergeler li { margin-bottom: 0.3rem; }
  .no-gosterge { color: #666; font-style: italic; }
  .aksiyon {
    background: #f5f5f7;
    border-radius: 6px;
    padding: 0.9rem 1.1rem;
  }
</style>
</head>
<body>

{% if risk_seviyesi == "Phishing" %}
  {% set risk_class = "risk-phishing" %}
{% elif risk_seviyesi == "Muhtemel Phishing" %}
  {% set risk_class = "risk-muhtemel" %}
{% else %}
  {% set risk_class = "risk-guvenilir" %}
{% endif %}

<div class="risk-banner {{ risk_class }}">{{ risk_seviyesi }}</div>

{% if subject or date %}
<div class="meta">
  {% if subject %}<div><strong>Konu:</strong> {{ subject }}</div>{% endif %}
  {% if date %}<div><strong>Tarih:</strong> {{ date }}</div>{% endif %}
</div>
{% endif %}

<section>
  <h2>Sonuç ve Gerekçe</h2>
  <p>{{ sonuc_ve_gerekce }}</p>
</section>

<section>
  <h2>Genel Değerlendirme</h2>
  <p>{{ genel_degerlendirme }}</p>
</section>

<section>
  <h2>Teknik Bulgular</h2>
  {% for bulgu in teknik_bulgular %}
  <div class="finding">
    <div class="finding-baslik">{{ bulgu.baslik }}</div>
    <div class="finding-aciklama">{{ bulgu.aciklama }}</div>
  </div>
  {% endfor %}
</section>

<section>
  <h2>Phishing Göstergeleri</h2>
  {% if phishing_gostergeleri %}
  <ul class="gostergeler">
    {% for gosterge in phishing_gostergeleri %}
    <li>{{ gosterge }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="no-gosterge">Belirgin bir phishing göstergesi tespit edilmedi.</p>
  {% endif %}
</section>

<section>
  <h2>Önerilen Aksiyon</h2>
  <p class="aksiyon">{{ onerilen_aksiyon }}</p>
</section>

</body>
</html>
